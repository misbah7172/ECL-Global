# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/ecl_global?schema=public"

# Authentication
SESSION_SECRET="your-session-secret-here-min-32-characters"
JWT_SECRET="your-jwt-secret-here"

# Stripe Configuration (Optional)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# Facebook Pixel Configuration (Optional - for ad campaigns)
# Get your Pixel ID from Meta Business Suite
VITE_FACEBOOK_PIXEL_ID="YOUR_PIXEL_ID"

# Application
NODE_ENV="development"
PORT=5000
